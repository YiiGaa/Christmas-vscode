{
  "name": "christmas",
  "displayName": "Christmas",
  "publisher": "Christmas",
  "description": "A extension for the Christmas tool, which is a generic code generator.",
  "version": "3.0.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "icon": "resources/logo.png",
  "engines": {
    "vscode": "^1.79.0"
  },
  "keywords": [
    "Christmas",
    "stoprefactoring",
    "stop refactoring"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/YiiGaa/Christmas-vscode"
  },
  "readme": "README.md",
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:Christmas",
    "workspaceContains:Christmas/Christmas.py"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configurationDefaults": {
      "christmas": {
        "editor.formatOnType": true
      }
    },
    "configuration": {
      "title": "Typescript",
      "properties": {
        "typescript.active": {
          "type": "boolean",
          "default": false,
          "description": "Complete functions with their parameter signature."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "christmas",
          "title": "Christmas",
          "icon": "resources/logo.svg"
        }
      ]
    },
    "views": {
      "christmas": [
        {
          "id": "christmas-menu",
          "name": "menu",
          "when": "viewEnabled"
        }
      ]
    },
    "commands": [
      {
        "command": "Christmas.runDouble",
        "title": "%run task%"
      },
      {
        "command": "Christmas.open",
        "title": "%open target file%",
        "icon": {
          "light": "resources/light/list-tree.svg",
          "dark": "resources/dark/list-tree.svg"
        }
      },
      {
        "command": "Christmas.refresh",
        "title": "%refresh%",
        "icon": {
          "light": "resources/light/refresh.svg",
          "dark": "resources/dark/refresh.svg"
        }
      },
      {
        "command": "Christmas.run",
        "title": "%run task%",
        "icon": {
          "light": "resources/light/run.svg",
          "dark": "resources/dark/run.svg"
        }
      },
      {
        "command": "Christmas.config",
        "title": "%open config file%",
        "icon": {
          "light": "resources/light/gear.svg",
          "dark": "resources/dark/gear.svg"
        }
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "Christmas.refresh",
          "when": "view == christmas-menu",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "Christmas.run",
          "when": "view == christmas-menu  && viewItem == task",
          "group": "inline@1"
        },
        {
          "command": "Christmas.open",
          "when": "view == christmas-menu && viewItem == task",
          "group": "inline@2"
        },
        {
          "command": "Christmas.config",
          "when": "view == christmas-menu && viewItem == task",
          "group": "inline@3"
        }
      ]
    },
    "languages": [
      {
        "id": "christmas",
        "aliases": [
          "Christmas",
          "christmas"
        ],
        "extensions": [
          ".xmas"
        ],
        "#configuration": "./language-configuration.json",
        "icon": {
          "light": "resources/light/file.svg",
          "dark": "resources/dark/file.svg"
        }
      }
    ],
    "#grammars": [
      {
        "language": "christmas",
        "scopeName": "source.xmas",
        "path": "./syntaxes/christmas.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "bundle-lsp": "ncc build src/lsp/service.ts -o dist -m && npx terser dist/index.js -o dist/index.js -c drop_console=true",
    "bundle-lsp-debug": "ncc build src/lsp/service.ts -o dist -m"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/js-yaml": "^4.0.9",
    "@types/mocha": "^10.0.1",
    "@types/node": "16.x",
    "@types/vscode": "^1.79.0",
    "@typescript-eslint/eslint-plugin": "^5.59.1",
    "@typescript-eslint/parser": "^5.59.1",
    "@vscode/test-electron": "^2.3.0",
    "eslint": "^8.39.0",
    "glob": "^8.1.0",
    "mocha": "^10.2.0",
    "terser": "^5.46.0",
    "typescript": "^5.0.4"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "json5": "^2.2.3",
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12"
  }
}
